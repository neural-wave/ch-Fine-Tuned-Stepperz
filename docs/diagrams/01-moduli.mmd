        validation --> rules["rules.py<br/>regole e Report"]
    end
    subgraph executionLayer["Calcolare e controllare il risultato"]
        api --> flat["flat.py<br/>aggregazioni globali semplici"]
        api --> nested["nested.py<br/>aggregazioni e provenienza"]

flowchart TB
    caller["Servizio chiamante<br/>query SPARQL e Dataset"] --> api["runtime.py<br/>execute_checked"]
    policy["policy.py<br/>Policy e dipendenze dei toggle"] -.-> api
    trusted["privacy.py<br/>ExecutionContext fidato"] -.-> api
    api --> privacy["privacy.py<br/>ACL, snapshot e storico"]

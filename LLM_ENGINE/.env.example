# The key below is a dummy value for the private Vast SSH tunnel.
LLM_BASE_URL=http://127.0.0.1:18080/v1
LLM_MODEL=Qwen/Qwen3-30B-A3B-GPTQ-Int4
LLM_FALLBACK_MODEL=qwen2.5:1.5b
LLM_API_KEY=EMPTY
LLM_TEMPERATURE=0
LLM_MAX_TOKENS=2048
LLM_TIMEOUT_SECONDS=180
# Optional standard Chat Completions parameter. 'none' disables Qwen3 thinking
# on current Ollama. Leave empty for a provider/model that does not accept it.
LLM_REASONING_EFFORT=
# Optional provider extensions, e.g. vLLM: {"chat_template_kwargs":{"enable_thinking":false}}
LLM_EXTRA_BODY={"chat_template_kwargs":{"enable_thinking":false}}

# Public SIB retrieval; generation runs on the remote Vast GPU through SSH.
MCP_URL=https://chat.expasy.org/mcp/
# Local mode after indexing: http://localhost:8888/mcp
MCP_TIMEOUT_SECONDS=90
MAX_AGENT_ITERATIONS=5
ENABLE_SPARQL_EXECUTION=false
# Execution requires a separate `sparql-agent execute` command and this flag.
TARGET_ENDPOINT=https://sparql.uniprot.org/sparql/
RESULTS_DIR=results
MAX_TOOL_RESULT_CHARS=12000
MAX_TOOLS_PER_ITERATION=4

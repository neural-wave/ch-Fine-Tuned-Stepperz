{
    "version": "0.2.0",
    "configurations": [
        {
            "name": "API: Python debugger",
            "type": "debugpy",
            "request": "launch",
            "module": "uvicorn",
            "python": "${workspaceFolder}/.venv/bin/python",
            "windows": {
                "python": "${workspaceFolder}/.venv/Scripts/python.exe"
            },
            "args": [
                "api.server:app",
                "--host", "0.0.0.0",
                "--port", "10100"
            ],
            "cwd": "${workspaceFolder}",
            "env": {
                "NL2SPARQL_CONFIG": "${workspaceFolder}/config/agents/models.json"
            },
            "console": "integratedTerminal",
            "justMyCode": true
        }
    ]
}

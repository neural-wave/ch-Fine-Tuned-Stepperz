# AVG di identificatori numerici attraverso alias aritmetico.
PREFIX sphn: <https://biomedit.ch/rdf/sphn-schema/sphn#>
SELECT (AVG(?alias) AS ?summary)
WHERE {
  GRAPH ?g {
    ?dx a sphn:BilledDiagnosis ;
        sphn:hasAdministrativeCase ?case ;
        sphn:hasSubjectPseudoIdentifier ?person .
    ?lab a sphn:LabTestEvent ;
         sphn:hasAdministrativeCase ?case ;
         sphn:hasSubjectPseudoIdentifier ?person ;
         sphn:hasQuantity ?quantity .
    ?quantity sphn:hasValue ?value .
    ?age a sphn:Age ;
         sphn:hasSubjectPseudoIdentifier ?person ;
         sphn:hasQuantity ?markerQuantity .
    ?markerQuantity sphn:hasValue ?marker .
  }
 GRAPH ?g { ?person sphn:hasIdentifier ?id . }
 BIND((?id + 0) AS ?alias)
}


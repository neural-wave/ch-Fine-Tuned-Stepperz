# Espressione aritmetica che dipende soltanto da conteggi globali.
PREFIX sphn: <https://biomedit.ch/rdf/sphn-schema/sphn#>
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>

SELECT (COUNT(DISTINCT ?g) AS ?patients)
       ((COUNT(DISTINCT ?lab) + COUNT(DISTINCT ?dx)) AS ?records)
WHERE {
  GRAPH ?g {
    ?dx a sphn:BilledDiagnosis .
    OPTIONAL { ?lab a sphn:LabTestEvent . }
  }
}

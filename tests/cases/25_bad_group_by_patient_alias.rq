# Conteggi individuali mascherati dietro un alias del grafo.
PREFIX sphn: <https://biomedit.ch/rdf/sphn-schema/sphn#>
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>

SELECT ?patient_label (COUNT(DISTINCT ?dx) AS ?diagnoses)
       (COUNT(DISTINCT ?lab) AS ?labs)
WHERE {
  GRAPH ?g {
    ?dx a sphn:BilledDiagnosis .
    OPTIONAL { ?lab a sphn:LabTestEvent . }
  }
  BIND(STR(?g) AS ?patient_label)
}
GROUP BY ?patient_label
ORDER BY DESC(?diagnoses)
